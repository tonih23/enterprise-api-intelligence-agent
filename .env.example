# Application configuration
API_AGENT_APP_NAME="Enterprise API Intelligence Agent"
API_AGENT_APP_VERSION="0.1.0"
API_AGENT_ENVIRONMENT="local"
API_AGENT_DEBUG="false"
API_AGENT_LOG_LEVEL="INFO"
API_AGENT_OPENSEARCH_URL="http://127.0.0.1:9200"
API_AGENT_OPENSEARCH_INDEX_NAME="api_document_chunks"
API_AGENT_OPENSEARCH_VERIFY_CERTS="false"
API_AGENT_EMBEDDING_BACKEND="local_hashing"
API_AGENT_EMBEDDING_MODEL_NAME="BAAI/bge-large-en-v1.5"
API_AGENT_EMBEDDING_BATCH_SIZE="32"
API_AGENT_ROUTER_BACKEND="deterministic"
API_AGENT_RAG_CHUNK_SIZE="1000"
API_AGENT_RAG_CHUNK_OVERLAP="150"
ENABLE_TRACING="false"
PHOENIX_COLLECTOR_ENDPOINT="http://127.0.0.1:6006/v1/traces"

# API container port
API_PORT="8000"

# Local Postgres service. Replace this sample password in your local .env.
POSTGRES_VERSION="16-alpine"
POSTGRES_DB="api_intelligence"
POSTGRES_USER="api_agent"
POSTGRES_PASSWORD="replace-with-a-local-development-password"
POSTGRES_PORT="5432"

# Local OpenSearch service. Security is disabled only for local development.
OPENSEARCH_VERSION="3.6.0"
OPENSEARCH_PORT="9200"
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# Local Phoenix UI and OTLP collector ports
PHOENIX_VERSION="latest"
PHOENIX_PORT="6006"
PHOENIX_GRPC_PORT="4317"

# Provider credentials will be added as their integration modules are
# implemented. Do not commit populated .env files.
